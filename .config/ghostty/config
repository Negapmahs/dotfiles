font-family = Mononoki Nerd Font Mono
cursor-style = block_hollow
cursor-style-blink = true
mouse-hide-while-typing = true
theme = Kanagawa Dragon
window-decoration = server
clipboard-write = allow
shell-integration = zsh
confirm-close-surface = false
linux-cgroup = always

keybind = ctrl+space>up=new_split:up
keybind = ctrl+space>right=new_split:right
keybind = ctrl+space>down=new_split:down
keybind = ctrl+space>left=new_split:left
keybind = ctrl+space>x=close_surface

keybind = ctrl+up=goto_split:up
keybind = ctrl+right=goto_split:right
keybind = ctrl+down=goto_split:down
keybind = ctrl+left=goto_split:left

keybind = ctrl+shift+r=activate_key_table:resize
keybind = resize/up=resize_split:up,10
keybind = resize/down=resize_split:down,10
keybind = resize/left=resize_split:left,10
keybind = resize/right=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
